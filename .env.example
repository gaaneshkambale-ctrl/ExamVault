# Copy this file to .env and fill in real values. .env is gitignored.

# SQL Server (containerized, SQL Authentication - not the Windows Trusted_Connection used for local dotnet run dev)
SQL_SA_PASSWORD=Change_This_Password123!

# RabbitMQ (containerized) - do not use "guest"/"guest", RabbitMQ blocks that account from non-localhost connections
RABBITMQ_USER=examvault
RABBITMQ_PASSWORD=Change_This_Password123!

# Must match the Jwt:SigningKey used locally if you want tokens to be interchangeable; otherwise any long random string
JWT_SIGNING_KEY=Change_This_To_A_Long_Random_Secret

# n8n webhook URLs (one per service that sends email) - same values as your local dotnet user-secrets
N8N_USER_WEBHOOK_URL=https://your-n8n-host/webhook/examvault/notify-credential
N8N_NOTIFICATION_WEBHOOK_URL=https://your-n8n-host/webhook/examvault/notify
N8N_AI_WEBHOOK_URL=https://your-n8n-host/webhook/examvault/generate-questions
